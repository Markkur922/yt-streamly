# ---------------------------------------------------------------------------
# База данных (Neon / PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Секрет для подписи JWT-сессий (обязательно замените в проде)
# ---------------------------------------------------------------------------
AUTH_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Cloudinary — облачное хранилище видео и превью
# Значения берутся из Dashboard: https://console.cloudinary.com/
# (Programmable Media → Dashboard → Account Details)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret

# Необязательно: папка в медиатеке (по умолчанию "streamly")
CLOUDINARY_FOLDER=streamly

# Альтернатива трём переменным выше — одна строка подключения:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ---------------------------------------------------------------------------
# Продакшен-расширения (опционально)
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# REDIS_URL=redis://127.0.0.1:6379
